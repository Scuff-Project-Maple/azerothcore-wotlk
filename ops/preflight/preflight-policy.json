{
  "version": 1,
  "_comment": [
    "Policy for the PRO-179 world-DB updater pre-flight gate.",
    "Every value here is a governance decision owned by Scuff (SQL) and reviewed by Scuff (Rev).",
    "Fail-closed rule: a table that is not listed in 'tables' (base tables) or 'customTables'",
    "cannot be written by a company-authored update file. Adding a table = a reviewed diff to this file.",
    "Bands come from docs/content-playbook.md section 2.4 (reserved ids) and PRO-175 (spawn-guid band)."
  ],

  "liveDatabase": "acore_world",
  "scratchDatabaseDefault": "acore_world_preflight",

  "includedDirs": [
    { "path": "$/data/sql/archive/db_world", "state": "ARCHIVED", "origin": "upstream" },
    { "path": "$/data/sql/custom/db_world", "state": "CUSTOM", "origin": "company" },
    { "path": "$/data/sql/updates/db_world", "state": "RELEASED", "origin": "upstream" },
    { "path": "$/data/sql/updates/pending_db_world", "state": "PENDING", "origin": "company" }
  ],

  "expectedSourceDirectory": "/azerothcore",
  "worldserverConfCandidates": ["env/dist/etc/worldserver.conf", "env/dist/etc/worldserver.conf.dist"],

  "companyEmailDomains": ["paperclip.local"],

  "writePolicyExemptOrigins": ["upstream"],

  "forbiddenStatements": [
    "ALTER", "DROP", "TRUNCATE", "RENAME", "GRANT", "REVOKE",
    "LOAD", "CALL", "LOCK", "UNLOCK", "HANDLER", "PREPARE", "DEALLOCATE",
    "KILL", "SHUTDOWN", "CREATE_USER", "SET_GLOBAL", "OPTIMIZE", "ANALYZE", "REPAIR", "CHECKSUM"
  ],

  "baseTables": {
    "creature_template": {
      "keyColumns": ["entry"],
      "bands": [{"column": "entry", "min": 900000}]
    },
    "creature": {
      "keyColumns": ["guid"],
      "keySets": [["guid"], ["id1", "map"]],
      "bands": [{"column": "guid", "min": 9000000}],
      "refs": [{"column": "id1", "min": 900000}],
      "_comment": "guid is the primary key and the reserved spawn band; (id1, map) is allowed as an alternative key because a content file legitimately re-spawns its own template, and id1 is itself band-checked. id2/id3 default to 0 and are therefore not refs."
    },
    "creature_addon": {
      "keyColumns": ["guid"],
      "bands": [{"column": "guid", "min": 9000000}]
    },
    "creature_template_model": {
      "keyColumns": ["CreatureID"],
      "bands": [{"column": "CreatureID", "min": 900000}]
    },
    "creature_template_spell": {
      "keyColumns": ["CreatureID"],
      "bands": [{"column": "CreatureID", "min": 900000}]
    },
    "creature_queststarter": {
      "keyColumns": ["id", "quest"],
      "refs": [{"column": "id", "min": 900000}, {"column": "quest", "min": 900000}]
    },
    "creature_questender": {
      "keyColumns": ["id", "quest"],
      "refs": [{"column": "id", "min": 900000}, {"column": "quest", "min": 900000}]
    },
    "creature_loot_template": {
      "keyColumns": ["Entry"],
      "bands": [{"column": "Entry", "min": 900000}]
    },
    "reference_loot_template": {
      "keyColumns": ["Entry"],
      "bands": [{"column": "Entry", "min": 900000}]
    },
    "quest_template": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "quest_template_addon": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "quest_request_items": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "quest_offer_reward": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "quest_details": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "quest_greeting": {
      "keyColumns": ["ID", "Type"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "gameobject": {
      "keyColumns": ["guid", "id"],
      "bands": [{"column": "guid", "min": 9000000}],
      "refs": [{"column": "id", "min": 900000}]
    },
    "gameobject_template": {
      "keyColumns": ["entry"],
      "bands": [{"column": "entry", "min": 900000}]
    },
    "gameobject_queststarter": {
      "keyColumns": ["id", "quest"],
      "refs": [{"column": "quest", "min": 900000}]
    },
    "gameobject_questender": {
      "keyColumns": ["id", "quest"],
      "refs": [{"column": "quest", "min": 900000}]
    },
    "gameobject_loot_template": {
      "keyColumns": ["Entry"],
      "bands": [{"column": "Entry", "min": 900000}]
    },
    "item_template": {
      "keyColumns": ["entry"],
      "bands": [{"column": "entry", "min": 900000}]
    },
    "item_loot_template": {
      "keyColumns": ["Entry"],
      "bands": [{"column": "Entry", "min": 900000}]
    },
    "page_text": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "gossip_menu": {
      "keyColumns": ["MenuID"],
      "bands": [{"column": "MenuID", "min": 900000}]
    },
    "gossip_menu_option": {
      "keyColumns": ["MenuID"],
      "bands": [{"column": "MenuID", "min": 900000}]
    },
    "npc_vendor": {
      "keyColumns": ["entry"],
      "bands": [{"column": "entry", "min": 900000}]
    },
    "npc_trainer": {
      "keyColumns": ["ID", "SpellID"],
      "refs": [{"column": "ID", "min": 900000}],
      "_comment": "PRIMARY KEY is (ID, SpellID); ID is the creature entry and must be a custom creature, so it is a reserved-band ref."
    },
    "npc_spellclick_spells": {
      "keyColumns": ["npc_entry"],
      "bands": [{"column": "npc_entry", "min": 900000}]
    },
    "smart_scripts": {
      "keyColumns": ["entryorguid", "source_type"],
      "bands": [],
      "_note": "entryorguid is only reserved-band-checked for source_type 0 (CREATURE) and 1 (GAMEOBJECT) by convention; the gate requires the literal to be present and >= 900000 unless the table entry sets bandOff."
    },
    "conditions": {
      "keyColumns": ["SourceTypeOrReferenceId", "SourceGroup", "SourceEntry", "SourceId", "ElseGroup", "ConditionTypeOrReference", "ConditionTarget", "ConditionValue1", "ConditionValue2", "ConditionValue3"],
      "keySets": [["SourceTypeOrReferenceId", "SourceGroup", "SourceEntry", "SourceId"]],
      "_comment": "keyColumns is the real PRIMARY KEY (there is no SourceType column). The keySets locator is the practical shape: it still pins one source object completely."
    },
    "spell_dbc": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "spell_loot_template": {
      "keyColumns": ["Entry"],
      "bands": [{"column": "Entry", "min": 900000}]
    },
    "spell_script_names": {
      "keyColumns": ["spell_id"],
      "bands": []
    },
    "spell_group": {
      "keyColumns": ["id"],
      "bands": []
    },
    "player_factionchange_achievement": {
      "keyColumns": ["alliance_id", "horde_id"],
      "bands": []
    },
    "achievement_reward": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "creature_onkill_reputation": {
      "keyColumns": ["creature_id"],
      "bands": [{"column": "creature_id", "min": 900000}]
    },
    "creature_text": {
      "keyColumns": ["CreatureID"],
      "bands": [{"column": "CreatureID", "min": 900000}]
    },
    "areatrigger_involvedrelation": {
      "keyColumns": ["id", "quest"],
      "bands": [],
      "refs": [{"column": "quest", "min": 900000}]
    },
    "areatrigger_scripts": {
      "keyColumns": ["entry"],
      "bands": []
    },
    "broadcast_text": {
      "keyColumns": ["ID"],
      "bands": [{"column": "ID", "min": 900000}]
    },
    "instance_template": {
      "keyColumns": ["map"],
      "bands": []
    },
    "creature_classlevelstats": {
      "keyColumns": ["level", "class"],
      "bands": []
    },
    "creature_equip_template": {
      "keyColumns": ["CreatureID", "ID"],
      "refs": [{"column": "CreatureID", "min": 900000}]
    },
    "creature_formations": {
      "keyColumns": ["memberGUID"],
      "bands": [{"column": "memberGUID", "min": 9000000}],
      "refs": [{"column": "leaderGUID", "min": 9000000}]
    },
    "creature_questitem": {
      "keyColumns": ["CreatureEntry", "Idx"],
      "refs": [{"column": "CreatureEntry", "min": 900000}]
    },
    "creature_immunities": {
      "keyColumns": ["ID"],
      "refs": [{"column": "ID", "min": 900000}]
    },
    "achievement_criteria_data": {
      "keyColumns": ["criteria_id", "type"],
      "bands": []
    },
    "broadcast_text_locale": {
      "keyColumns": ["ID", "locale"],
      "bands": []
    },
    "acore_string": {
      "keyColumns": ["entry"],
      "bands": []
    },
    "areatrigger": {
      "keyColumns": ["entry"],
      "bands": []
    },
    "areatrigger_tavern": {
      "keyColumns": ["id"],
      "bands": []
    },
    "areatrigger_teleport": {
      "keyColumns": ["ID"],
      "bands": []
    },
    "battleground_template": {
      "keyColumns": ["ID"],
      "bands": []
    },
    "command": {
      "keyColumns": ["name"],
      "bands": []
    }
  },

  "customTables": {
    "custom_class_template": {
      "keyColumns": ["template_key"]
    },
    "unbound_class_catalog": {
      "keyColumns": ["class_id"]
    },
    "unbound_milestones": {
      "keyColumns": ["milestone_index"]
    },
    "module_string": {
      "keyColumns": ["module", "id"]
    },
    "module_string_locale": {
      "keyColumns": ["module", "id", "locale"]
    },
    "_note": "Custom tables are the only place a company migration may put new schema. keyColumns are checked against the live PRIMARY KEY at run time and a mismatch is reported as a warning; a custom table with no PK is a hard failure."
  },

  "bootPath": {
    "worldserverService": "ac-worldserver",
    "updaterEnableEnv": "AC_UPDATES_ENABLE_DATABASES",
    "requireUpdaterBit": 4,
    "playerbotsEnableEnv": "AC_PLAYERBOTS_UPDATES_ENABLE_DATABASES",
    "requireReadOnlySqlMount": true,
    "_comment": "PRO-179 review B2. The updater reads $-relative paths from inside the container, so a green gate only means something if the container's /azerothcore/data/sql is a read-only bind of exactly the tree the gate walked and the core updater is enabled for DATABASE_WORLD (bit 4) alone. The Playerbots updater is a separate ledger and this gate neither reads nor writes it."
  },

  "allowUntrackedFiles": false,
  "deadReferenceWarnOnly": true,
  "hashCheck": {
    "ignoreArchivedPairMismatch": true,
    "emptyLedgerHashIsWarning": true
  }
}
